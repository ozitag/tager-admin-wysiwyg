{
  "name": "@tager/admin-wysiwyg",
  "version": "2.0.0",
  "description": "Визуальный редактор админки TAGER: CKEditor 5 с набором плагинов и настройками проекта",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && yarn emit-declarations",
    "emit-declarations": "tsc --project tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "prepare": "yarn build"
  },
  "dependencies": {
    "ckeditor5": "^49.1.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ozitag/tager-admin-wysiwyg.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
